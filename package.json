{
  "name": "animelatam-stremio-addon",
  "version": "1.7.0",
  "description": "Addon comunitario de Stremio que busca automáticamente fuentes de anime en español latino en AnimeAV1, Henaojara y Latanime.",
  "main": "index.js",
  "scripts": {
    "devStart": "nodemon index.js",
    "devStartApp": "nodemon index.js --launch",
    "devStartWeb": "nodemon index.js --webLaunch",
    "start": "node index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bruizr/AnimeLatam.git"
  },
  "keywords": ["stremio", "anime", "latino", "node.js", "express.js"],
  "license": "MIT",
  "bugs": {"url": "https://github.com/bruizr/AnimeLatam/issues"},
  "homepage": "https://github.com/bruizr/AnimeLatam#readme",
  "dependencies": {
    "cheerio": "^1.1.2",
    "dotenv": "^16.5.0",
    "ejs": "^6.0.1",
    "express": "^4.21.1",
    "fuzzysort": "^3.1.0",
    "unpacker": "^1.0.1"
  },
  "devDependencies": {"nodemon": "^3.1.7"}
}