<style>
*{box-sizing:border-box}
:root{color-scheme:dark;--accent:#a78bfa;--muted:#aaa9bd}
html,body{margin:0;min-height:100%;width:100%;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:#f7f6ff}
body{min-height:100vh;padding:42px 18px;background:linear-gradient(135deg,rgba(7,7,18,.96),rgba(19,13,36,.94)),url("<%= manifest?.background || '' %>") center/cover fixed;display:flex;align-items:center;justify-content:center}
.config-panel{width:min(100%,680px);padding:34px;border:1px solid rgba(255,255,255,.1);border-radius:24px;background:rgba(15,14,29,.92);box-shadow:0 24px 80px rgba(0,0,0,.4);backdrop-filter:blur(18px)}
.hero{text-align:center;padding:8px 8px 30px}
.eyebrow{font-size:10px;letter-spacing:2px;font-weight:800;color:#b9a5ff}
.status-dot{display:inline-block;width:7px;height:7px;margin-right:8px;border-radius:50%;background:#a78bfa;box-shadow:0 0 12px #a78bfa}
.hero h1{font-size:36px;line-height:1.1;margin:16px 0 12px;letter-spacing:-1px}
.hero p,.section-description,.credits-section p{font-size:14px;line-height:1.7;color:var(--muted);margin:0 auto;max-width:540px}
.sources-section,.credits-section{padding:24px 0;border-top:1px solid rgba(255,255,255,.09)}
.sources-section h2,.credits-section h2{font-size:16px;margin:0 0 8px}
.section-description{margin:0 0 18px;max-width:none;font-size:12px}
.source-logos{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.source-logo{min-height:116px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:18px 10px;border:1px solid rgba(255,255,255,.1);border-radius:16px;background:rgba(255,255,255,.035);color:#fff;text-decoration:none;transition:transform .18s,border-color .18s,background .18s}
.source-logo:hover{transform:translateY(-3px);border-color:rgba(167,139,250,.6);background:rgba(167,139,250,.08)}
.source-logo img{width:42px;height:42px;object-fit:contain;border-radius:10px;background:#fff;padding:5px}
.source-logo strong{font-size:13px}
.credits-section p{max-width:none;margin:0 0 12px;font-size:13px}
.credits-card{display:flex;flex-direction:column;gap:8px;padding:16px 18px;border:1px solid rgba(255,255,255,.1);border-radius:14px;background:rgba(255,255,255,.035)}
.credits-card strong{font-size:14px;color:#fff}
.credits-card a{font-size:12px;color:#b9a5ff;text-decoration:none;overflow-wrap:anywhere}
.credits-card a:hover{color:#fff;text-decoration:underline}
.config-footer{text-align:center;padding-top:12px;color:#77768d;font-size:11px}
@media(max-width:520px){body{padding:16px 10px}.config-panel{padding:24px 18px}.hero h1{font-size:30px}.source-logos{gap:8px}.source-logo{min-height:100px;padding:12px 6px}.source-logo strong{font-size:11px}}
</style>